+namespace {
+constexpr double kGbaFrameHz = 16777216.0 / 280896.0;
+// Locked, the pacer only catches a renderer whose vsync does not block: it
+// limits to 3% above refresh / k, so vsync sets the cadence.
+constexpr double kLockPacerMargin = 0.97;
+
+void set_display_lock(Backend* b, int refresh_hz, int refreshes) {
+    DisplayLock& d = b->lock;
+    if (d.refreshes == refreshes && (!refreshes || d.refresh_hz == refresh_hz)) return;
+#if SDL_VERSION_ATLEAST(2, 0, 18)
+    if (SDL_RenderSetVSync(b->renderer, refreshes || d.vsync_forced ? 1 : 0) != 0 && refreshes) {
+        std::fprintf(stderr, "host_window: display lock off, cannot enable vsync: %s\n", SDL_GetError());
+        d.failed = true;
+        refreshes = 0;
+    }
+#endif
+    if (refreshes)
+        std::fprintf(stderr, "host_window: display lock %d Hz, %d refresh%s per frame (%.3f fps)\n",
+                     refresh_hz, refreshes, refreshes == 1 ? "" : "es",
+                     double(refresh_hz) / refreshes);
+    else if (d.refreshes)
+        std::fprintf(stderr, "host_window: display lock off\n");
+    std::fflush(stderr);
+    // The game now produces audio at refresh / k instead of 59.7275 Hz (+0.46%
+    // at 60 and 120 Hz), beyond the bridge's default 0.5% servo range once the
+    // device clock's own drift adds up. Allow up to 1.2% (20 cents) while locked.
+    if (b->bridge_ready) {
+        SDL_LockMutex(b->audio_mtx);
+        b->bridge.cfg.max_correction = refreshes ? 0.012 : b->lock.default_correction;
+        SDL_UnlockMutex(b->audio_mtx);
+    }
+    d.refresh_hz = refresh_hz;
+    d.refreshes = refreshes;
+    d.last = {};
+    d.interval_sum = 0.0;
+    d.intervals = 0;
+}
+}  // namespace
+
+double HostWindow::finish_frame(bool real_time) {
+    if (!open_ || !impl_) return kGbaFrameHz;
+    auto* b = static_cast<Backend*>(impl_);
+    DisplayLock& d = b->lock;
+    if (!d.allowed || d.failed) return kGbaFrameHz;
+    if (!real_time) {
+        set_display_lock(b, 0, 0);
+        d.query_in = 0;
+        return kGbaFrameHz;
+    }
+    if (--d.query_in <= 0) {  // the window may move to another display
+        d.query_in = 120;
+        int refresh = 0, k = 0;
+        const int di = SDL_GetWindowDisplayIndex(b->window);
+        SDL_DisplayMode dm{};
+        if (di >= 0 && SDL_GetCurrentDisplayMode(di, &dm) == 0) refresh = dm.refresh_rate;
+        if (refresh > 0) {
+            k = int(std::lround(refresh / kGbaFrameHz));
+            const double rate = k > 0 ? double(refresh) / k : 0.0;
+            if (k < 1 || k > 8 || std::fabs(rate / kGbaFrameHz - 1.0) > 0.005) k = 0;
+        }
+        set_display_lock(b, refresh, k);
+    }
+    if (!d.refreshes) return kGbaFrameHz;
+    // The frame was presented once; show it for the remaining refreshes.
+    if (b->presentation_source_w) {
+        d.repeating = true;
+        static const uint8_t unused = 0;
+        for (int i = 1; i < d.refreshes; ++i)
+            present(&unused, b->presentation_source_w, b->presentation_source_h);
+        d.repeating = false;
+    }
+    // Vsync must be what holds the cadence. If frames come at the pacer's
+    // faster limit instead, presents do not wait for the display.
+    const auto now = std::chrono::steady_clock::now();
+    if (d.last != std::chrono::steady_clock::time_point{}) {
+        d.interval_sum += std::chrono::duration<double>(now - d.last).count();
+        if (++d.intervals == 240) {
+            const double mean = d.interval_sum / d.intervals;
+            const double expected = double(d.refreshes) / d.refresh_hz;
+            if (mean < expected * 0.985) {
+                std::fprintf(stderr, "host_window: display lock off, vsync does not wait "
+                             "(%.2f ms per frame, %.2f expected)\n", mean * 1e3, expected * 1e3);
+                set_display_lock(b, 0, 0);
+                d.failed = true;
+                d.last = {};
+                return kGbaFrameHz;
+            }
+            d.interval_sum = 0.0;
+            d.intervals = 0;
+        }
+    }
+    d.last = now;
+    return double(d.refresh_hz) / d.refreshes / kLockPacerMargin;
+}
