+void FramePacer::set_target_hz(double hz) {
+    if (hz <= 0.0) return;
+    const auto period = std::chrono::nanoseconds(static_cast<long long>(1e9 / hz));
+    if (period == period_) return;
+    next_ += period - period_;
+    period_ = period;
+}
+
 void FramePacer::reset() {
     next_ = clock::now() + period_;
 }
