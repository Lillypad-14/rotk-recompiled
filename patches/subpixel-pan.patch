+// Presentation-only subpixel offsets for the internal resolution, set by the
+// host before each frame (for example from the present scanline hook). Each
+// value is in 1/256 of a native pixel. BG x is -255..255 and moves that
+// layer's content right (positive) or left (negative); BG y is 0..255 and moves
+// it down (lines resolve top to bottom, so the row below is not known yet).
+// OBJ offsets are 0..255 and move right/down. The host folds whole pixels into
+// the scroll registers and OAM; this only adds the remaining fraction. `obj`
+// returns the offsets of OBJ `index` (0..127 hardware OAM, 128 and up extra
+// objects), false for none. Lines with affine or HD tile layers keep their
+// regular resolve.
+struct SubpixelShift {
+    bool active = false;
+    int16_t bg[4][2] = {};
+    bool (*obj)(unsigned index, uint8_t* dx, uint8_t* dy) = nullptr;
+};
