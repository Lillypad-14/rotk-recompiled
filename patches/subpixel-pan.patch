+// A subpixel line: each output subpixel takes every layer's pixel from the
+// native column and row that cover it once the layer is moved right/down by
+// its offset, then composites them like the native stack. Content moves at
+// most one native pixel, so only this column and the one to its left, and this
+// row and the one above, can cover a subpixel (BGs moving left take the column
+// to the right instead). Missing neighbours at the edges repeat the edge pixel
+// for BGs.
+void GbaHighResolutionFrame::resolve_subpixel() {
+    ++subpixel_lines_;
+    const auto& current = sub_rows_[sub_current_];
+    const bool above = sub_previous_row_ != ~0u && sub_previous_row_ + 1 == row_;
+    const auto& previous = above ? sub_rows_[sub_current_ ^ 1] : current;
+    struct Candidate { const SubpixelObj* obj; bool same_column; };
+    const uint32_t y_breaks = 1u | sub_bg_y_breaks_ | sub_obj_y_breaks_[sub_current_] |
+                              (above ? sub_obj_y_breaks_[sub_current_ ^ 1] : 0u);
+    const size_t row_bytes = size_t(width()) * 3;
+    for (unsigned sy = 0; sy < scale_; ++sy) {
+        auto* dst = work_.data() + size_t(row_ * scale_ + sy) * width() * 3;
+        if (!(y_breaks & (1u << sy))) { std::memcpy(dst, dst - row_bytes, row_bytes); continue; }
+        const SubpixelColumn* bg_rows[4];
+        for (unsigned bg = 0; bg < 4; ++bg)
+            bg_rows[bg] = (sy >= sub_bg_[bg][1] ? current : previous).data();
+        for (unsigned x = 0; x < width_; ++x) {
+            if (black_[x]) {
+                std::memset(dst, 0, size_t(scale_) * 3); dst += scale_ * 3;
+                continue;
+            }
+            const uint8_t window = windows_[x];
+            Candidate candidates[8];
+            unsigned count = 0;
+            uint32_t x_breaks = sub_bg_x_breaks_;
+            if (window & 0x10) {
+                for (unsigned column = x + 1; column-- > x - (x ? 1 : 0);) {
+                    for (const auto& o : current[column].obj)
+                        if (o.pixel.valid && (!above || sy >= o.dy)) {
+                            candidates[count++] = {&o, column == x};
+                            x_breaks |= 1u << o.dx;
+                        }
+                    if (above)
+                        for (const auto& o : previous[column].obj)
+                            if (o.pixel.valid && sy < o.dy) {
+                                candidates[count++] = {&o, column == x};
+                                x_breaks |= 1u << o.dx;
+                            }
+                }
+            }
+            for (unsigned sx = 0; sx < scale_; ++sx, dst += 3) {
+                if (sx && !(x_breaks & (1u << sx))) {
+                    dst[0] = dst[-3]; dst[1] = dst[-2]; dst[2] = dst[-1];
+                    continue;
+                }
+                Pixel top = top_[x], second = second_[x];
+                for (unsigned bg = 0; bg < 4; ++bg) {
+                    if (!(window & (1u << bg))) continue;
+                    const int column = std::clamp(int(x) + sub_bg_lo_[bg] + (sx >= sub_bg_[bg][0]), 0,
+                                                  int(width_) - 1);
+                    const Pixel& p = bg_rows[bg][column].bg[bg];
+                    if (p.valid) insert(top, second, p);
+                }
+                for (unsigned i = 0; i < count; ++i) {
+                    const Candidate& c = candidates[i];
+                    if ((sx >= c.obj->dx) == c.same_column) insert(top, second, c.obj->pixel);
+                }
+                write_color(dst, top, second);
+            }
+        }
+    }
+    sub_previous_row_ = row_;
+    sub_current_ ^= 1u;
+    wrote_line(row_);
