+void GbaHighResolutionFrame::match_hd_tiles(uint16_t dispcnt, const uint8_t* io,
+                                            const uint8_t* vram) {
+    hd_frame_prepared_ = true;
+    hd_frame_matched_ = 0;
+    const HdRegistry& registry = hd_registry();
+    const unsigned mode = dispcnt & 7;
+    for (unsigned bg = 0; bg < 4; ++bg) {
+        HdLayer& layer = hd_layers_[bg];
+        layer.any = false;
+        const uint16_t cnt = u16(io + 0x08 + bg * 2);
+        if (!(dispcnt & (0x100u << bg)) || mode > 1 || (mode == 1 && bg >= 2) || (cnt & 0x80)) continue;
+        const unsigned chars = ((cnt >> 2) & 3) * 0x4000, screen = ((cnt >> 8) & 31) * 0x800;
+        const unsigned tw = (cnt & 0x4000) ? 64 : 32, th = (cnt & 0x8000) ? 64 : 32;
+        layer.tiles_w = tw; layer.tiles_h = th;
+        layer.cells.assign(size_t(tw) * th, HdCell{});
+        layer.rows.assign(th, 0);
+        auto entry_at = [&](unsigned tx, unsigned ty) -> uint16_t {
+            tx %= tw; ty %= th;
+            const unsigned address = screen + ((tx >> 5) + (ty >> 5) * (tw / 32)) * 0x800 +
+                                     ((ty & 31) * 32 + (tx & 31)) * 2;
+            return address + 1 < kBgVram ? u16(vram + address) : 0;
+        };
+        auto tile_at = [&](uint16_t entry) -> const uint8_t* {
+            const unsigned address = chars + (entry & 0x3ffu) * kTileBytes;
+            return address + kTileBytes <= kBgVram ? vram + address : nullptr;
+        };
+        for (unsigned ty = 0; ty < th; ++ty)
+            for (unsigned tx = 0; tx < tw; ++tx) {
+                if (layer.cells[size_t(ty) * tw + tx].image) continue;
+                const uint16_t entry = entry_at(tx, ty);
+                const uint8_t* tile = tile_at(entry);
+                if ((entry & 0x0c00) || !tile) continue;
+                const auto anchor = registry.anchors.find(tile_hash(tile));
+                if (anchor == registry.anchors.end()) continue;
+                const HdTileImage& image = registry.images[anchor->second.first];
+                const unsigned ox = tx + tw - anchor->second.second % image.tiles_w;
+                const unsigned oy = ty + th - anchor->second.second / image.tiles_w;
+                bool whole = true;
+                for (unsigned r = 0; r < image.tiles_h && whole; ++r)
+                    for (unsigned c = 0; c < image.tiles_w && whole; ++c) {
+                        const uint16_t e = entry_at(ox + c, oy + r);
+                        const uint8_t* t = tile_at(e);
+                        whole = !(e & 0x0c00) && t &&
+                            std::memcmp(t, image.tiles.data() + (r * image.tiles_w + c) * kTileBytes, kTileBytes) == 0;
+                    }
+                if (!whole) continue;
+                for (unsigned r = 0; r < image.tiles_h; ++r)
+                    for (unsigned c = 0; c < image.tiles_w; ++c) {
+                        const unsigned cx = (ox + c) % tw, cy = (oy + r) % th;
+                        layer.cells[size_t(cy) * tw + cx] = {uint16_t(anchor->second.first + 1), uint8_t(c), uint8_t(r)};
+                        layer.rows[cy] = 1;
+                    }
+                layer.any = true;
+                ++hd_frame_matched_;
+            }
+    }
+}
