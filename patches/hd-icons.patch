+// Premultiplied RGBA resample: area average when shrinking, bilinear when growing.
+std::vector<uint8_t> resample(const HdTileImage& image, unsigned out_w, unsigned out_h) {
+    std::vector<uint8_t> out(size_t(out_w) * out_h * 4);
+    const float sx = float(image.width) / out_w, sy = float(image.height) / out_h;
+    auto texel = [&](int x, int y, unsigned c) {
+        x = std::clamp(x, 0, int(image.width) - 1); y = std::clamp(y, 0, int(image.height) - 1);
+        return float(image.rgba[(size_t(y) * image.width + x) * 4 + c]);
+    };
+    for (unsigned y = 0; y < out_h; ++y)
+        for (unsigned x = 0; x < out_w; ++x)
+            for (unsigned c = 0; c < 4; ++c) {
+                float value = 0;
+                if (sx <= 1.0f && sy <= 1.0f) {
+                    const float fx = (x + 0.5f) * sx - 0.5f, fy = (y + 0.5f) * sy - 0.5f;
+                    const int x0 = int(std::floor(fx)), y0 = int(std::floor(fy));
+                    const float wx = fx - x0, wy = fy - y0;
+                    value = (texel(x0, y0, c) * (1 - wx) + texel(x0 + 1, y0, c) * wx) * (1 - wy) +
+                            (texel(x0, y0 + 1, c) * (1 - wx) + texel(x0 + 1, y0 + 1, c) * wx) * wy;
+                } else {
+                    const float x0 = x * sx, x1 = x0 + sx, y0 = y * sy, y1 = y0 + sy;
+                    float sum = 0, weight = 0;
+                    for (int ty = int(y0); ty < int(std::ceil(y1)); ++ty) {
+                        const float wy = std::min(y1, ty + 1.0f) - std::max(y0, float(ty));
+                        for (int tx = int(x0); tx < int(std::ceil(x1)); ++tx) {
+                            const float w = wy * (std::min(x1, tx + 1.0f) - std::max(x0, float(tx)));
+                            sum += texel(tx, ty, c) * w; weight += w;
+                        }
+                    }
+                    value = weight > 0 ? sum / weight : 0;
+                }
+                out[(size_t(y) * out_w + x) * 4 + c] = uint8_t(std::clamp(value + 0.5f, 0.0f, 255.0f));
+            }
