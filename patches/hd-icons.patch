+            const unsigned tx = (unsigned(hx) + hofs) & (layer.tiles_w * 8 - 1);
+            const HdCell& cell = layer.cells[size_t(ty >> 3) * layer.tiles_w + (tx >> 3)];
+            if (!cell.image) continue;
