+void hd_tiles_set(std::vector<HdTileImage> images) {
+    HdRegistry& registry = hd_registry();
+    registry = HdRegistry{};
+    std::unordered_map<uint64_t, unsigned> counts;
+    for (const auto& image : images)
+        for (size_t t = 0; t + kTileBytes <= image.tiles.size(); t += kTileBytes)
+            ++counts[tile_hash(image.tiles.data() + t)];
+    static const uint8_t blank[kTileBytes] = {};
+    const uint64_t blank_hash = tile_hash(blank);
+    for (size_t i = 0; i < images.size(); ++i)
+        for (size_t t = 0; t + kTileBytes <= images[i].tiles.size(); t += kTileBytes) {
+            const uint64_t h = tile_hash(images[i].tiles.data() + t);
+            if (h != blank_hash && counts[h] == 1)
+                registry.anchors[h] = {uint16_t(i), uint16_t(t / kTileBytes)};
+        }
+    registry.images = std::move(images);
+}
