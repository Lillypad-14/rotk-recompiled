diff --git a/src/consoles/gba/gba_pad_binds.c b/src/consoles/gba/gba_pad_binds.c
new file mode 100644
index 0000000..43790af
--- /dev/null
+++ b/src/consoles/gba/gba_pad_binds.c
@@ -0,0 +1,86 @@
+// consoles/gba/gba_pad_binds.c — the GBA shape of the shared per-GUID input.ini
+// store. See gba_pad_binds.h.
+
+#include "gba_pad_binds.h"
+#include "pad_binds.h"
+
+#include <stdio.h>
+#include <string.h>
+
+// kGbaPadButtons order: Up Down Left Right A B L R Start Select.
+static const char* const kGbaPadKeyName[] = {
+    "up", "down", "left", "right", "a", "b", "l", "r", "start", "select",
+};
+
+// gbarecomp's built-in controller layout (player_controls.cpp kPadDefaults).
+static const char* const kGbaPadDefaults[] = {
+    "dpup", "dpdown", "dpleft", "dpright", "a", "b",
+    "leftshoulder", "rightshoulder", "start", "back",
+};
+
+static const char kGbaSeed[] =
+    "; GBA controller mapping, shared with the game. A GBA button is pressed\n"
+    "; when its listed source is. [mapping.<guid>] is one controller's layout\n"
+    "; and stick dead zone (percent); [mapping] is the fallback for the rest.\n"
+    "; The left stick always moves too. Keyboard keys are in keybinds.ini.\n\n";
+
+static const RuiPadSpec kGbaPadSpec = {
+    kGbaPadKeyName,
+    kGbaPadDefaults,
+    (int)(sizeof(kGbaPadKeyName) / sizeof(kGbaPadKeyName[0])),
+    4,                                   /* four d-pad cardinals ... */
+    RUI_GBA_PAD_DEFAULT_DEADZONE_PCT,
+    0,
+    kGbaSeed,
+    0,
+    0,                                   /* ... starting at Up, index 0 */
+};
+
+void rui_gba_pad_binds_path(const char* keybinds_path, char* out, int cap) {
+    rui_pad_binds_sibling_path(keybinds_path, "input.ini", out, cap);
+}
+
+void rui_gba_pad_binds_init(const char* path) {
+    rui_pad_binds_init(&kGbaPadSpec, path);
+}
+
+// input.ini sources as players read them; the game's menu uses the same words
+// (gbarecomp player_controls.cpp display_name, generic column).
+static const char* const kGbaSourceNames[][2] = {
+    {"a", "A"}, {"b", "B"}, {"x", "X"}, {"y", "Y"}, {"back", "Back"}, {"guide", "Guide"},
+    {"start", "Start"}, {"leftstick", "Left stick press"}, {"rightstick", "Right stick press"},
+    {"leftshoulder", "Left bumper"}, {"rightshoulder", "Right bumper"},
+    {"dpup", "D-pad Up"}, {"dpdown", "D-pad Down"}, {"dpleft", "D-pad Left"}, {"dpright", "D-pad Right"},
+    {"misc1", "Share"}, {"paddle1", "Paddle 1"}, {"paddle2", "Paddle 2"}, {"paddle3", "Paddle 3"},
+    {"paddle4", "Paddle 4"}, {"touchpad", "Touchpad"},
+    {"lefttrigger+", "Left trigger"}, {"righttrigger+", "Right trigger"},
+    {"leftx-", "Left stick Left"}, {"leftx+", "Left stick Right"},
+    {"lefty-", "Left stick Up"}, {"lefty+", "Left stick Down"},
+    {"rightx-", "Right stick Left"}, {"rightx+", "Right stick Right"},
+    {"righty-", "Right stick Up"}, {"righty+", "Right stick Down"},
+};
+
+void rui_gba_pad_binds_label(const char* path, const char* guid, int b,
+                             char* out, int cap) {
+    rui_pad_binds_label(&kGbaPadSpec, path, guid, b, out, cap);
+    if (!out || cap <= 0) return;
+    for (size_t i = 0; i < sizeof(kGbaSourceNames) / sizeof(kGbaSourceNames[0]); ++i) {
+        if (strcmp(out, kGbaSourceNames[i][0]) != 0) continue;
+        snprintf(out, (size_t)cap, "%s", kGbaSourceNames[i][1]);
+        return;
+    }
+}
+
+void rui_gba_pad_binds_set(const char* path, const char* guid, int b,
+                           int kind, int code, int axis_dir) {
+    rui_pad_binds_set(&kGbaPadSpec, path, guid, b, kind, code, axis_dir);
+}
+
+void rui_gba_pad_binds_reset(const char* path, const char* guid) {
+    rui_pad_binds_reset(&kGbaPadSpec, path, guid);
+}
+
+void rui_gba_pad_binds_remember(const char* path, const char* guid,
+                                const char* name) {
+    rui_pad_binds_remember(&kGbaPadSpec, path, guid, name, -1);
+}
diff --git a/src/consoles/gba/gba_pad_binds.h b/src/consoles/gba/gba_pad_binds.h
new file mode 100644
index 0000000..b87eead
--- /dev/null
+++ b/src/consoles/gba/gba_pad_binds.h
@@ -0,0 +1,36 @@
+// consoles/gba/gba_pad_binds.h — the GBA shape of the shared per-GUID input.ini
+// store (common/pad_binds.h).
+//
+// gbarecomp reads the same file (src/runtime/player_controls.h): [mapping] is
+// every controller's fallback, [mapping.<guid>] one controller's layout and
+// stick dead zone. Keys are the GBA inputs by name (a b select start right left
+// up down r l), so the table below is in the launcher's display order
+// (gba_profile.h kGbaPadButtons) and the runtime's KEYINPUT order never has to
+// match it. Keyboard keys stay in keybinds.ini.
+
+#ifndef RUI_CONSOLE_GBA_PAD_BINDS_H
+#define RUI_CONSOLE_GBA_PAD_BINDS_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define RUI_GBA_PAD_DEFAULT_DEADZONE_PCT 50
+
+// input.ini next to `keybinds_path`.
+void rui_gba_pad_binds_path(const char* keybinds_path, char* out, int cap);
+void rui_gba_pad_binds_init(const char* path);
+// Label for button `b` (launcher order); an empty guid shows the fallback.
+void rui_gba_pad_binds_label(const char* path, const char* guid, int b,
+                             char* out, int cap);
+void rui_gba_pad_binds_set(const char* path, const char* guid, int b,
+                           int kind, int code, int axis_dir);
+void rui_gba_pad_binds_reset(const char* path, const char* guid);
+void rui_gba_pad_binds_remember(const char* path, const char* guid,
+                                const char* name);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // RUI_CONSOLE_GBA_PAD_BINDS_H
