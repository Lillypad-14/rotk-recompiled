+    // The BIOS under the ROM, for a console that boots one (has_bios): whether
+    // it verified, and its own Browse button, so the front page alone sets the
+    // game up. PLAY stays disabled until it verifies (launcher_model_can_launch);
+    // Settings > System has the same picker. A host-named system file keeps
+    // the notice below instead.
+    if (launcher_model_bios_applies(m) && !m->bios_name) {
+        const bool bios_ok = m->setup_bios_ok;
+        const char* bios_line = bios_ok              ? "BIOS verified"
+                                : m->s.bios_path[0] ? "BIOS not recognized"
+                                                     : "No BIOS loaded";
+        ImGui::Dummy(ImVec2(0, px(10)));
+        float bw = ImGui::GetTextLineHeight() + px(6) + ImGui::CalcTextSize(bios_line).x;
+        ImGui::SetCursorPosX(ImGui::GetCursorPosX() + (availw - bw) * 0.5f);
+        state_mark(bios_ok, th);
+        ImGui::SameLine(0, px(6));
+        ImGui::TextColored(bios_ok ? col(th.good) : col(th.warn), "%s", bios_line);
+        if (!bios_ok && m->setup_bios_detail[0]) {
+            ImGui::PushTextWrapPos(ImGui::GetCursorPosX() + availw);
+            ImGui::TextColored(col(th.text_muted), "%s", m->setup_bios_detail);
+            ImGui::PopTextWrapPos();
+        }
+        ImGui::Dummy(ImVec2(0, px(6)));
+        char bios_label[48];
+        snprintf(bios_label, sizeof(bios_label), "%s %s", ui_text("Browse For"), ui_text("BIOS"));
+        if (ImGui::Button(bios_label, ImVec2(availw, px(34))))
+            request_bios_picker(m, NULL, false);
+    }
