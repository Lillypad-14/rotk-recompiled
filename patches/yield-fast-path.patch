+
+// The common instruction has no yield side effects. Keep its predicate small
+// rather than saving the registers needed by presentation/session diagnostics
+// on every instruction. Any potentially observable operation uses the original
+// path, including BIOS prefetch, mutable-code hooks and pending VBlank work.
+extern "C" bool runtime_should_yield(void) {
+    auto* bus = gbarecomp::g_active_bus;
+    if (g_session_execution ||
+        (bus && g_cpu.R[15] < 0x00004000u) ||
+        g_runtime_force_interp_hook || g_frame_present_quit ||
+        (g_irq_nest_depth == 0u &&
+         g_runtime_vblank_starts != g_runtime_yielded_vblank_start) ||
+        yield_watchdog_enabled() ||
+        (g_runtime_break_pc != 0u && g_cpu.R[15] == g_runtime_break_pc))
+        return runtime_should_yield_slow();
+    return bus && bus->io().halted();
+}
