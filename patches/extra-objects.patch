+// Priority key layout shared by BG and OBJ candidates: objects of priority p use
+// p*kObjKeyStride + OAM index, backgrounds p*kObjKeyStride + kBgKeyBase + layer.
+constexpr unsigned kObjKeyStride = 4096u;
+constexpr unsigned kBgKeyBase = 4092u;
+constexpr uint32_t kMaxExtraObjects = kBgKeyBase - 128u;
+
+const uint8_t* extra_objects(uint32_t* count) {
+    *count = 0;
+    if (!g_extra_obj_provider) return nullptr;
+    const uint8_t* entries = g_extra_obj_provider(count);
+    if (!entries) *count = 0;
+    if (*count > kMaxExtraObjects) *count = kMaxExtraObjects;
+    return entries;
+}
