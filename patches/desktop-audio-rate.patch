+void HostWindow::push_audio_block(const int16_t* samples, std::size_t count,
+                                 uint32_t rate) {
+    if (!open_ || !impl_ || !samples || !count) return;
+    if (rate != 32768 && rate != 65536 && rate != 131072 && rate != 262144) return;
+    auto* b = static_cast<Backend*>(impl_);
+    auto drain = [&]() {
+        int16_t converted[4096];
+        int bytes = 0;
+        while ((bytes = SDL_AudioStreamGet(b->audio_rate_stream, converted,
+                                          sizeof(converted))) > 0) {
+            push_audio_samples(converted, static_cast<std::size_t>(bytes) / sizeof(int16_t));
+        }
+    };
+    if (rate != b->audio_source_rate) {
+        if (b->audio_rate_stream) {
+            SDL_AudioStreamFlush(b->audio_rate_stream);
+            drain();
+            SDL_FreeAudioStream(b->audio_rate_stream);
+            b->audio_rate_stream = nullptr;
+        }
+        b->audio_source_rate = rate;
+        if (rate != 65536) {
+            b->audio_rate_stream = SDL_NewAudioStream(AUDIO_S16SYS, 1, rate,
+                                                      AUDIO_S16SYS, 1, 65536);
+            if (!b->audio_rate_stream) {
+                throw std::runtime_error(std::string("audio rate conversion: ") + SDL_GetError());
+            }
+        }
+    }
+    if (rate == 65536) {
+        push_audio_samples(samples, count);
+    } else {
+        if (SDL_AudioStreamPut(b->audio_rate_stream, samples,
+                              static_cast<int>(count * sizeof(int16_t))) < 0) {
+            throw std::runtime_error(std::string("audio rate conversion: ") + SDL_GetError());
+        }
+        drain();
+    }
