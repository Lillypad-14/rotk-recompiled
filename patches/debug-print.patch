@@ -176,6 +176,24 @@ void GbaBus::note_io_write(uint32_t off, uint8_t width) {
     waits_apply_waitcnt(*waits_, masked);
 }
 
+bool GbaBus::debug_print_write(uint32_t off, uint32_t value, uint8_t width) {
+    constexpr uint32_t kText = 0xFFF600u, kFlags = 0xFFF700u, kEnable = 0xFFF780u;
+    constexpr uint32_t kSend = 0x100u;
+    if (off >= kText && off < kFlags) {
+        for (uint8_t i = 0; i < width && off - kText + i < 256u; ++i)
+            debug_text_[off - kText + i] = static_cast<char>(value >> (8 * i));
+        return true;
+    }
+    if (off == kFlags) {
+        if (value & kSend) {
+            std::fprintf(stderr, "[gba:debug] %s\n", debug_text_);
+            std::memset(debug_text_, 0, sizeof(debug_text_));
+        }
+        return true;
+    }
+    return off == kEnable;
+}
