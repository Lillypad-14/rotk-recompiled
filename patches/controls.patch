+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <utility>
+
+namespace gbarecomp::controls {
+
+const char* const kButtonKeys[kButtons] = {
+    "a", "b", "select", "start", "right", "left", "up", "down", "r", "l"};
+const char* const kButtonLabels[kButtons] = {
+    "A", "B", "Select", "Start", "Right", "Left", "Up", "Down", "R", "L"};
+
+namespace {
+
+// Keyboard defaults. Player 1 matches recomp-ui's keybinds defaults; player 2
+// is the split-screen layout players already know (WASD, J/K, G, Space, U/I).
+const char* const kPlayerOneKeys[kButtons] = {
+    "X", "Z", "Right Shift", "Return", "Right", "Left", "Up", "Down", "V", "C"};
+const char* const kPlayerTwoKeys[kButtons] = {
+    "J", "K", "G", "Space", "D", "A", "W", "S", "I", "U"};
+const char* const kPadDefaults[kButtons] = {
+    "a", "b", "back", "start", "dpright", "dpleft", "dpup", "dpdown",
+    "rightshoulder", "leftshoulder"};
+
+std::string lower(std::string s) {
+    for (char& c : s) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    return s;
+}
+
+std::string trim(const std::string& s) {
+    std::size_t a = 0, b = s.size();
+    while (a < b && std::isspace(static_cast<unsigned char>(s[a]))) ++a;
+    while (b > a && std::isspace(static_cast<unsigned char>(s[b - 1]))) --b;
+    return s.substr(a, b - a);
+}
+
+int button_index(const std::string& key) {
+    const std::string k = lower(key);
+    for (int i = 0; i < kButtons; ++i)
+        if (k == kButtonKeys[i]) return i;
+    return -1;
+}
+
+std::vector<std::string> read_lines(const std::string& path) {
+    std::vector<std::string> lines;
+    std::ifstream f(path);
+    for (std::string line; std::getline(f, line);) {
+        if (!line.empty() && line.back() == '\r') line.pop_back();
+        lines.push_back(line);
+    }
+    return lines;
+}
+
+// Calls fn(section, key, value) for every key line; section is lowercase.
+template <typename Fn>
+void scan(const std::string& path, Fn fn) {
+    std::string section;
+    for (const std::string& raw : read_lines(path)) {
+        const std::string line = trim(raw);
+        if (line.empty() || line[0] == '#' || line[0] == ';') continue;
+        if (line[0] == '[') {
+            const std::size_t end = line.find(']');
+            section = lower(line.substr(1, end == std::string::npos ? std::string::npos : end - 1));
+            continue;
+        }
+        const std::size_t eq = line.find('=');
+        if (eq == std::string::npos) continue;
+        fn(section, trim(line.substr(0, eq)), trim(line.substr(eq + 1)));
+    }
+}
+
+using Values = std::vector<std::pair<std::string, std::string>>;
+
+// Sets `values` in [section] of the file: matching keys are replaced in place,
+// missing ones are appended to the section (created at the end if absent), and
+// `remove` keys are deleted. Everything else, comments included, is kept.
+bool write_section(const std::string& path, const std::string& section, const Values& values,
+                   const std::vector<std::string>& remove = {}) {
+    std::vector<std::string> lines = read_lines(path);
+    std::vector<bool> done(values.size(), false);
+    const std::string want = lower(section);
+    int start = -1, end = static_cast<int>(lines.size());
+    for (int i = 0; i < static_cast<int>(lines.size()); ++i) {
+        const std::string line = trim(lines[i]);
+        if (line.empty() || line[0] != '[') continue;
+        const std::size_t close = line.find(']');
+        const std::string name = lower(line.substr(1, close == std::string::npos ? std::string::npos : close - 1));
+        if (start >= 0) { end = i; break; }
+        if (name == want) start = i;
+    }
+    if (start >= 0) {
+        for (int i = start + 1; i < end; ++i) {
+            const std::string line = trim(lines[i]);
+            const std::size_t eq = line.find('=');
+            if (line.empty() || line[0] == '#' || line[0] == ';' || eq == std::string::npos) continue;
+            const std::string key = lower(trim(line.substr(0, eq)));
+            for (const std::string& r : remove)
+                if (lower(r) == key) lines[i] = "";
+            for (std::size_t v = 0; v < values.size(); ++v) {
+                if (done[v] || lower(values[v].first) != key) continue;
+                lines[i] = values[v].first + " = " + values[v].second;
+                done[v] = true;
+            }
+        }
+        // Append after the section's last non-blank line.
+        int at = end;
+        while (at > start + 1 && trim(lines[at - 1]).empty()) --at;
+        std::vector<std::string> add;
+        for (std::size_t v = 0; v < values.size(); ++v)
+            if (!done[v]) add.push_back(values[v].first + " = " + values[v].second);
+        lines.insert(lines.begin() + at, add.begin(), add.end());
+        lines.erase(std::remove(lines.begin(), lines.end(), std::string("")), lines.end());
+    } else {
+        if (!lines.empty() && !trim(lines.back()).empty()) lines.push_back("");
+        lines.push_back("[" + section + "]");
+        for (const auto& [key, value] : values) lines.push_back(key + " = " + value);
+    }
+    const std::string tmp = path + ".tmp";
+    {
+        std::ofstream f(tmp, std::ios::trunc | std::ios::binary);
+        if (!f) return false;
+        for (const std::string& line : lines) f << line << "\n";
+        if (!f) return false;
+    }
+    std::remove(path.c_str());
+    return std::rename(tmp.c_str(), path.c_str()) == 0;
+}
+
+std::string key_name(int scancode, const Names& names) {
+    const char* n = scancode > 0 ? names.scancode_name(scancode) : nullptr;
+    return n && n[0] ? n : "None";
+}
+
+int key_code(const std::string& name, const Names& names) {
+    if (name.empty() || lower(name) == "none") return 0;
+    const int sc = names.scancode(name.c_str());
+    return sc > 0 ? sc : 0;
+}
+
+PlayerSetting* other(Settings& s, int player) { return &s.player[player ^ 1]; }
+
+}  // namespace
+
+PadBind parse_bind(const std::string& text, const Names& names) {
+    PadBind bind;
+    const std::string t = lower(trim(text));
+    if (t.empty() || t == "none") return bind;
+    if (t.back() == '+' || t.back() == '-') {
+        const int axis = names.axis(t.substr(0, t.size() - 1).c_str());
+        if (axis < 0 || axis >= kPadAxes) return bind;
+        bind.kind = t.back() == '-' ? PadBind::AxisNegative : PadBind::AxisPositive;
+        bind.code = axis;
+        return bind;
+    }
+    const int button = names.button(t.c_str());
+    if (button < 0 || button >= kPadButtons) return bind;
+    bind.kind = PadBind::Button;
+    bind.code = button;
+    return bind;
+}
+
+std::string bind_name(const PadBind& bind, const Names& names) {
+    if (bind.kind == PadBind::Button) {
+        const char* n = names.button_name(bind.code);
+        return n ? n : "";
+    }
+    if (bind.kind == PadBind::AxisNegative || bind.kind == PadBind::AxisPositive) {
+        const char* n = names.axis_name(bind.code);
+        return std::string(n ? n : "axis") + (bind.kind == PadBind::AxisNegative ? "-" : "+");
+    }
+    return "";
+}
+
+Settings defaults(const Names& names) {
+    Settings s;
+    for (int i = 0; i < kButtons; ++i) {
+        s.player[0].keys[i] = key_code(kPlayerOneKeys[i], names);
+        s.player[1].keys[i] = key_code(kPlayerTwoKeys[i], names);
+        s.global.bind[i] = parse_bind(kPadDefaults[i], names);
+        s.global.set[i] = true;
+    }
+    s.global.deadzone_set = true;
+    return s;
+}
+
+Settings load(const std::string& dir, const Names& names) {
+    Settings s = defaults(names);
+    const std::string base = dir.empty() ? std::string() : dir + "/";
+    scan(base + "config.ini", [&](const std::string& section, const std::string& key, const std::string& value) {
+        if (section != "controller") return;
+        const std::string k = lower(key);
+        for (int p = 0; p < 2; ++p) {
+            const std::string n = std::to_string(p + 1);
+            if (k == "sourcep" + n) {
+                const int v = std::atoi(value.c_str());
+                if (v >= 0 && v <= 3) s.player[p].source = static_cast<Source>(v);
+            } else if (k == "guidp" + n) {
+                s.player[p].guid = lower(value);
+            }
+        }
+        if (k == "controlsversion") s.version = std::atoi(value.c_str());
+    });
+    scan(base + "keybinds.ini", [&](const std::string& section, const std::string& key, const std::string& value) {
+        const int p = section == "player1" ? 0 : section == "player2" ? 1 : -1;
+        const int b = button_index(key);
+        if (p < 0 || b < 0) return;
+        s.player[p].keys[b] = key_code(value, names);
+    });
+    scan(base + "input.ini", [&](const std::string& section, const std::string& key, const std::string& value) {
+        if (section == "gamepads") {
+            s.pad_names[lower(key)] = value;
+            return;
+        }
+        PadProfile* profile = nullptr;
+        if (section == "mapping") profile = &s.global;
+        else if (section.rfind("mapping.", 0) == 0 && section.size() > 8) profile = &s.pads[section.substr(8)];
+        if (!profile) return;
+        if (lower(key) == "deadzone") {
+            profile->deadzone_pct = std::clamp(std::atoi(value.c_str()), 0, 100);
+            profile->deadzone_set = true;
+            return;
+        }
+        const int b = button_index(key);
+        if (b < 0) return;
+        profile->bind[b] = parse_bind(value, names);
+        profile->set[b] = true;
+    });
+    return s;
+}
+
+bool save(const std::string& dir, const Settings& s, const Names& names) {
+    const std::string base = dir.empty() ? std::string() : dir + "/";
+    // Auto is written as no SourceP<n> at all, which every launcher reads as
+    // its default (Auto in recomp-ui-controls.patch; older ones read 0..2 only).
+    Values controller;
+    std::vector<std::string> removed;
+    for (int p = 0; p < 2; ++p) {
+        const std::string n = std::to_string(p + 1);
+        if (s.player[p].source == Source::Auto) {
+            removed.push_back("SourceP" + n);
+        } else {
+            controller.emplace_back("SourceP" + n, std::to_string(static_cast<int>(s.player[p].source)));
+        }
+        controller.emplace_back("GuidP" + n, s.player[p].guid);
+    }
+    controller.emplace_back("ControlsVersion", std::to_string(s.version));
+    bool ok = write_section(base + "config.ini", "Controller", controller, removed);
+    for (int p = 0; p < 2; ++p) {
+        Values keys;
+        for (int i = 0; i < kButtons; ++i) keys.emplace_back(kButtonKeys[i], key_name(s.player[p].keys[i], names));
+        ok = write_section(base + "keybinds.ini", p ? "player2" : "player1", keys) && ok;
+    }
+    Values global;
+    for (int i = 0; i < kButtons; ++i)
+        global.emplace_back(kButtonKeys[i], s.global.set[i] ? bind_name(s.global.bind[i], names) : kPadDefaults[i]);
+    ok = write_section(base + "input.ini", "mapping", global) && ok;
+    for (const auto& [guid, profile] : s.pads) {
+        Values values;
+        if (profile.deadzone_set) values.emplace_back("deadzone", std::to_string(profile.deadzone_pct));
+        for (int i = 0; i < kButtons; ++i)
+            if (profile.set[i]) values.emplace_back(kButtonKeys[i], bind_name(profile.bind[i], names));
+        if (!values.empty()) ok = write_section(base + "input.ini", "mapping." + guid, values) && ok;
+    }
+    Values known;
+    for (const auto& [guid, name] : s.pad_names) known.emplace_back(guid, name);
+    if (!known.empty()) ok = write_section(base + "input.ini", "gamepads", known) && ok;
+    return ok;
+}
+
+PadProfile profile_for(const Settings& s, const std::string& guid) {
+    PadProfile out = s.global;
+    const auto it = s.pads.find(lower(guid));
+    if (it == s.pads.end()) return out;
+    for (int i = 0; i < kButtons; ++i)
+        if (it->second.set[i]) out.bind[i] = it->second.bind[i];
+    if (it->second.deadzone_set) out.deadzone_pct = it->second.deadzone_pct;
+    return out;
+}
+
+std::uint16_t key_buttons(const int keys[kButtons], const std::uint8_t* keyboard, int key_count) {
+    std::uint16_t held = 0;
+    if (!keyboard) return 0;
+    for (int i = 0; i < kButtons; ++i)
+        if (keys[i] > 0 && keys[i] < key_count && keyboard[keys[i]]) held |= 1u << i;
+    return held;
+}
+
+std::uint16_t pad_buttons(const PadProfile& profile, const PadState& state) {
+    const int threshold = std::clamp(profile.deadzone_pct, 5, 95) * 32767 / 100;
+    std::uint16_t held = 0;
+    for (int i = 0; i < kButtons; ++i) {
+        const PadBind& b = profile.bind[i];
+        if (b.kind == PadBind::Button && b.code < kPadButtons && state.button[b.code]) held |= 1u << i;
+        if (b.kind == PadBind::AxisNegative && b.code < kPadAxes && state.axis[b.code] < -threshold) held |= 1u << i;
+        if (b.kind == PadBind::AxisPositive && b.code < kPadAxes && state.axis[b.code] > threshold) held |= 1u << i;
+    }
+    // The left stick always moves.
+    if (state.axis[kLeftX] > threshold) held |= 1u << 4;
+    if (state.axis[kLeftX] < -threshold) held |= 1u << 5;
+    if (state.axis[kLeftY] < -threshold) held |= 1u << 6;
+    if (state.axis[kLeftY] > threshold) held |= 1u << 7;
+    return held;
+}
+
+Assignment assign(const Settings& s, const std::vector<PadInfo>& pads) {
+    Assignment a;
+    std::vector<bool> taken(pads.size(), false);
+    auto take = [&](int p, const std::string& guid) {
+        for (std::size_t i = 0; i < pads.size(); ++i) {
+            if (taken[i] || (!guid.empty() && lower(pads[i].guid) != guid)) continue;
+            taken[i] = true;
+            a.pad[p] = static_cast<int>(i);
+            return;
+        }
+    };
+    for (int p = 0; p < 2; ++p)
+        if (s.player[p].source == Source::Gamepad && !s.player[p].guid.empty()) take(p, s.player[p].guid);
+    for (int p = 0; p < 2; ++p)
+        if (s.player[p].source == Source::Gamepad && s.player[p].guid.empty()) take(p, "");
+    for (int p = 0; p < 2; ++p)
+        if (s.player[p].source == Source::Auto) take(p, "");
+    for (int p = 0; p < 2; ++p) {
+        const Source src = s.player[p].source;
+        a.waiting[p] = src == Source::Gamepad && a.pad[p] < 0;
+        a.keyboard[p] = src == Source::Keyboard || src == Source::Auto || a.waiting[p];
+    }
+    return a;
+}
+
+void claim_pad(Settings& s, int player, const std::string& guid) {
+    const std::string g = lower(guid);
+    PlayerSetting& me = s.player[player];
+    PlayerSetting* them = other(s, player);
+    if (them->source == Source::Gamepad && them->guid == g) {
+        them->source = me.source;
+        them->guid = me.guid;
+    }
+    me.source = Source::Gamepad;
+    me.guid = g;
+}
+
+void claim_keyboard(Settings& s, int player) {
+    s.player[player].source = Source::Keyboard;
+    s.player[player].guid.clear();
+}
+
+void swap_players(Settings& s) { std::swap(s.player[0], s.player[1]); }
+
+int set_key(PlayerSetting& player, int button, int scancode) {
+    if (button < 0 || button >= kButtons) return -1;
+    int swapped = -1;
+    for (int i = 0; i < kButtons; ++i) {
+        if (i != button && scancode > 0 && player.keys[i] == scancode) {
+            player.keys[i] = player.keys[button];
+            swapped = i;
+        }
+    }
+    player.keys[button] = scancode;
+    return swapped;
+}
+
+int set_pad_bind(Settings& s, const std::string& guid, int button, const PadBind& bind) {
+    if (button < 0 || button >= kButtons) return -1;
+    const std::string g = lower(guid);
+    const PadProfile current = profile_for(s, g);
+    PadProfile& target = g.empty() ? s.global : s.pads[g];
+    int swapped = -1;
+    for (int i = 0; i < kButtons; ++i) {
+        if (i == button || bind.kind == PadBind::Unbound) continue;
+        if (current.bind[i].kind == bind.kind && current.bind[i].code == bind.code) {
+            target.bind[i] = current.bind[button];
+            target.set[i] = true;
+            swapped = i;
+        }
+    }
+    target.bind[button] = bind;
+    target.set[button] = true;
+    return swapped;
+}
+
+void reset_keys(Settings& s, int player, const Names& names) {
+    const Settings d = defaults(names);
+    std::copy(std::begin(d.player[player].keys), std::end(d.player[player].keys), s.player[player].keys);
+}
+
+void reset_pad(Settings& s, const std::string& guid, const Names& names) {
+    const std::string g = lower(guid);
+    if (g.empty()) {
+        const int deadzone = s.global.deadzone_pct;
+        s.global = defaults(names).global;
+        s.global.deadzone_pct = deadzone;
+        return;
+    }
+    const auto it = s.pads.find(g);
+    if (it == s.pads.end()) return;
+    for (int i = 0; i < kButtons; ++i) it->second.set[i] = false;
+    it->second.deadzone_set = false;
+}
+
+}  // namespace gbarecomp::controls
diff --git a/src/runtime/player_controls.h b/src/runtime/player_controls.h
new file mode 100644
index 0000000..94fcbae
--- /dev/null
+++ b/src/runtime/player_controls.h
@@ -0,0 +1,144 @@
+// player_controls.h — both players' input devices and bindings, without SDL.
+//
+// Files (all in the exe directory, shared with recomp-ui's launcher):
+//   * config.ini [Controller]: SourceP1/SourceP2 (0 None, 1 Keyboard, 2 Gamepad;
+//     3 or absent = Auto, keyboard plus the first free controller; save()
+//     writes Auto as no key, which launchers before Auto also read cleanly) and
+//     GuidP1/GuidP2 (a Gamepad player's controller; empty = the first free one).
+//     ControlsVersion marks a completed migration from older settings.
+//   * keybinds.ini [player1]/[player2]: keyboard keys per GBA button (SDL
+//     scancode names), recomp-ui's generic format.
+//   * input.ini: controller bindings, recomp-ui's pad_binds format. [mapping] is
+//     the fallback for every controller, [mapping.<guid>] one controller's
+//     overrides plus its stick dead zone; [gamepads] names the known ones.
+//     Bindings belong to the controller, not the player, so a controller keeps
+//     its layout when it changes hands.
+//
+// A player reads the keyboard only when their source is Keyboard or Auto, or
+// while their Gamepad is missing (then `waiting` is set so the game can say so).
+// The left stick always moves, past the controller's dead zone.
+//
+// SDL names are resolved through Names so this file builds and tests headless;
+// host_window.cpp supplies SDL's lookups.
+
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace gbarecomp::controls {
+
+constexpr int kButtons = 10;   // GBA KEYINPUT bit order: A B Select Start Right Left Up Down R L
+constexpr int kPadButtons = 32;
+constexpr int kPadAxes = 8;
+constexpr int kLeftX = 0;      // SDL_CONTROLLER_AXIS_LEFTX / LEFTY
+constexpr int kLeftY = 1;
+
+enum class Source : int { None = 0, Keyboard = 1, Gamepad = 2, Auto = 3 };
+
+// keybinds.ini / input.ini key per GBA button, in KEYINPUT bit order.
+extern const char* const kButtonKeys[kButtons];
+extern const char* const kButtonLabels[kButtons];
+
+struct PadBind {
+    enum Kind : std::uint8_t { Unbound, Button, AxisNegative, AxisPositive };
+    Kind kind = Unbound;
+    int code = 0;   // SDL_GameControllerButton or SDL_GameControllerAxis
+};
+
+struct PadProfile {
+    PadBind bind[kButtons];
+    bool set[kButtons] = {};   // per-controller profiles override only what they set
+    int deadzone_pct = 50;
+    bool deadzone_set = false;
+};
+
+struct PlayerSetting {
+    Source source = Source::Auto;
+    std::string guid;
+    int keys[kButtons] = {};   // SDL scancodes, 0 = unbound
+};
+
+struct Settings {
+    PlayerSetting player[2];
+    PadProfile global;                               // [mapping]
+    std::map<std::string, PadProfile> pads;          // [mapping.<guid>]
+    std::map<std::string, std::string> pad_names;    // [gamepads]
+    int version = 0;                                 // [Controller] ControlsVersion
+};
+
+// SDL lookups (names are case-insensitive; unknown returns -1, "None" 0 for keys).
+struct Names {
+    int (*scancode)(const char* name);
+    const char* (*scancode_name)(int scancode);
+    int (*button)(const char* name);
+    const char* (*button_name)(int button);
+    int (*axis)(const char* name);
+    const char* (*axis_name)(int axis);
+};
+
+// One controller's live state, filled by the host from SDL.
+struct PadState {
+    bool button[kPadButtons] = {};
+    std::int16_t axis[kPadAxes] = {};
+};
+
+struct PadInfo {
+    int id = -1;          // SDL_JoystickID
+    std::string guid;     // lowercase SDL GUID string
+};
+
+// A connected controller as the host reports it (runtime.h connected_controllers).
+struct ConnectedController {
+    std::string guid;
+    std::string name;
+    int type = 0;      // SDL_GameControllerType (Xbox, PlayStation, Nintendo, ...)
+    int player = -1;   // the player using it, -1 = free
+};
+
+struct Assignment {
+    int pad[2] = {-1, -1};          // index into the pads list, -1 = none
+    bool keyboard[2] = {};          // reads its keyboard keys
+    bool waiting[2] = {};           // wants a controller, none free: keyboard fallback
+};
+
+Settings defaults(const Names& names);
+// Missing files keep the defaults. Unknown names leave a binding unbound.
+Settings load(const std::string& dir, const Names& names);
+// Rewrites only the keys this module owns; every other line is kept.
+bool save(const std::string& dir, const Settings& settings, const Names& names);
+
+// The profile a controller uses: its own overrides over [mapping].
+PadProfile profile_for(const Settings& settings, const std::string& guid);
+// "a", "dpup", "leftx-", "" for unbound (input.ini source strings).
+std::string bind_name(const PadBind& bind, const Names& names);
+PadBind parse_bind(const std::string& text, const Names& names);
+
+// Pressed GBA buttons (active-high bits).
+std::uint16_t key_buttons(const int keys[kButtons], const std::uint8_t* keyboard, int key_count);
+std::uint16_t pad_buttons(const PadProfile& profile, const PadState& state);
+
+// Which controller each player gets. Players with a named controller claim it
+// first, then Gamepad players, then Auto players, each taking the first free
+// controller in connection order.
+Assignment assign(const Settings& settings, const std::vector<PadInfo>& pads);
+
+// The device a player just pressed something on becomes theirs. If the other
+// player had that controller, the two players trade devices.
+void claim_pad(Settings& settings, int player, const std::string& guid);
+void claim_keyboard(Settings& settings, int player);
+// Players trade devices and keyboard keys.
+void swap_players(Settings& settings);
+// Sets a key; a key another button of the same player used moves to this
+// button's old key, so nothing is left unbound by accident. Returns the button
+// that was swapped, or -1.
+int set_key(PlayerSetting& player, int button, int scancode);
+// The same for one controller's profile (written to [mapping.<guid>], or
+// [mapping] when guid is empty).
+int set_pad_bind(Settings& settings, const std::string& guid, int button, const PadBind& bind);
+void reset_keys(Settings& settings, int player, const Names& names);
+void reset_pad(Settings& settings, const std::string& guid, const Names& names);
+
+}  // namespace gbarecomp::controls
