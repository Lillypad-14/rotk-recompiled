+#else
+    (void)b; (void)text;
+#endif
+}
+
+// The waiting prompt, kept on screen until the press arrives.
+void set_controls_prompt(Backend* b, const char* text) {
+    b->controls_prompt = text ? text : "";
+    b->controls_prompt_at = SDL_GetTicks();
+    set_controls_status(b, text);
+}
+
+void finish_capture(Backend* b, const char* status) {
+    b->capture = Backend::Capture{};
+    b->controls_prompt.clear();
+    set_controls_status(b, status);
+}
+
+// Per pump: keep the prompt up, give up a stale capture, end our toast.
+void tick_controls(Backend* b) {
+    const Uint32 now = SDL_GetTicks();
+    if (b->capture.player >= 0 && SDL_TICKS_PASSED(now, b->capture.until))
+        finish_capture(b, "Cancelled");
+    if (!b->controls_prompt.empty() && (b->capture.player >= 0 || b->claim_player >= 0) &&
+        SDL_TICKS_PASSED(now, b->controls_prompt_at + 2500))
+        set_controls_prompt(b, b->controls_prompt.c_str());
+#if defined(GBARECOMP_RUNTIME_UI)
+    if (b->controls_toast_until && SDL_TICKS_PASSED(now, b->controls_toast_until)) {
+        b->controls_toast_until = 0;
+        if (b->runtime_ui) recomp_runtime_ui_set_toast(b->runtime_ui, nullptr, nullptr);
+    }
+#endif
+}
+
+// Press to bind and press to assign take the next key or controller press
+// before the menu or the game sees it. Returns true when the event was used.
+bool capture_event(Backend* b, const SDL_Event& e) {
+    const bool key = e.type == SDL_KEYDOWN && !e.key.repeat;
+    const bool escape = key && e.key.keysym.scancode == SDL_SCANCODE_ESCAPE;
+    if (b->claim_player >= 0) {
+        const int player = b->claim_player;
+        char text[96];
+        if (escape) {
+            b->claim_player = -1;
+            finish_capture(b, "Cancelled");
+            return true;
+        }
+        if (key) {
+            controls::claim_keyboard(b->controls, player);
+            std::snprintf(text, sizeof(text), "Player %d plays on the keyboard", player + 1);
+        } else if (e.type == SDL_CONTROLLERBUTTONDOWN) {
+            std::size_t i = 0;
+            while (i < b->pads.size() && controller_instance(b->pads[i]) != e.cbutton.which) ++i;
+            if (i == b->pads.size()) return true;
+            controls::claim_pad(b->controls, player, b->pad_guids[i]);
+            const char* name = SDL_GameControllerName(b->pads[i]);
+            std::snprintf(text, sizeof(text), "Player %d plays on %s", player + 1, name ? name : "this controller");
+        } else {
+            return false;
+        }
+        b->claim_player = -1;
+        b->controls.version = std::max(b->controls.version, 2);
+        save_player_controls(b);
+        finish_capture(b, text);
+        return true;
+    }
+    if (b->capture.player < 0) return false;
+    const int player = b->capture.player;
+    const int button = b->capture.button;
+    char text[96];
+    if (escape) {
+        finish_capture(b, "Cancelled");
+        return true;
+    }
+    int swapped = -1;
+    if (!b->capture.pad) {
+        if (!key) return e.type == SDL_CONTROLLERBUTTONDOWN;
+        swapped = controls::set_key(b->controls.player[player], button, e.key.keysym.scancode);
+        std::snprintf(text, sizeof(text), "Player %d %s = %s", player + 1, controls::kButtonLabels[button],
+                      SDL_GetScancodeName(e.key.keysym.scancode));
+    } else {
+        const SDL_JoystickID from = e.type == SDL_CONTROLLERBUTTONDOWN ? e.cbutton.which
+                                  : e.type == SDL_CONTROLLERAXISMOTION ? e.caxis.which : -1;
+        if (from < 0) return key;
+        // Only the player's own controller, or any one while they have none.
+        const int mine = b->assigned.pad[player];
+        std::size_t i = 0;
+        while (i < b->pads.size() && controller_instance(b->pads[i]) != from) ++i;
+        if (i == b->pads.size() || (mine >= 0 && static_cast<int>(i) != mine)) return true;
+        controls::PadBind bind;
+        if (e.type == SDL_CONTROLLERBUTTONDOWN) {
+            bind = {controls::PadBind::Button, e.cbutton.button};
+        } else {
+            if (e.caxis.value > -24000 && e.caxis.value < 24000) return true;
+            bind = {e.caxis.value < 0 ? controls::PadBind::AxisNegative : controls::PadBind::AxisPositive,
+                    e.caxis.axis};
+        }
+        // Their controller's layout, or the shared fallback the menu shows while they have none.
+        swapped = controls::set_pad_bind(b->controls, mine >= 0 ? b->pad_guids[i] : std::string(), button, bind);
+        std::snprintf(text, sizeof(text), "Player %d %s = %s", player + 1, controls::kButtonLabels[button],
+                      controls::bind_name(bind, sdl_control_names()).c_str());
+    }
+    if (swapped >= 0) {
+        const std::size_t used = std::strlen(text);
+        std::snprintf(text + used, sizeof(text) - used, " (swapped with %s)", controls::kButtonLabels[swapped]);
+    }
+    b->controls.version = std::max(b->controls.version, 2);
+    save_player_controls(b);
+    finish_capture(b, text);
+    return true;
+}
+
+void load_player_controls(Backend* b, const char* dir) {
+    b->controls = controls::load(dir, sdl_control_names());
+    b->controls_dir = dir;
+    for (std::size_t i = 0; i < b->pads.size(); ++i) {
+        const char* name = SDL_GameControllerName(b->pads[i]);
+        if (name && !b->controls.pad_names.count(b->pad_guids[i])) b->controls.pad_names[b->pad_guids[i]] = name;
+    }
+    // ControlsVersion 1: player 2's keys start from their own defaults. The
+    // launcher seeds keybinds.ini [player2] with player 1's keys, which were
+    // never read before, and would move both players at once.
+    if (b->controls.version < 1) {
+        const controls::Settings built_in = controls::defaults(sdl_control_names());
+        std::copy(std::begin(built_in.player[1].keys), std::end(built_in.player[1].keys),
+                  b->controls.player[1].keys);
+        b->controls.version = 1;
+        save_player_controls(b);
+    }
+    apply_legacy_player_two(b);
+    reassign_controllers(b);
+}
