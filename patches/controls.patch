 // Start Right Left Up Down R L): SDL key names (SDL_GetScancodeFromName) and SDL game controller
 // button names (SDL_GameControllerGetButtonFromString). A null array or entry, or an unknown name,
 // keeps that control. The left stick always moves too.
+// Superseded by the player controls below: these values are migrated once into
+// keybinds.ini [player2] (and a changed controller button into input.ini
+// [mapping]), unless the player has already changed controls there.
 void set_player_two_controls(const char* const keys[10], const char* const buttons[10]);
 
+// ---- Player controls (player_controls.h) ----------------------------------
+// Both players' devices and bindings on the game's window. set_player_controls
+// saves them to the exe directory (config.ini [Controller], keybinds.ini,
+// input.ini) and hands out the controllers again at once. Without a window
+// these return defaults and do nothing.
+controls::Settings player_controls();
+void set_player_controls(const controls::Settings& settings);
+const controls::Names& player_control_names();
+
+// Connected controllers in connection order (player_controller's indices).
+std::vector<controls::ConnectedController> connected_controllers();
+int player_controller(int player);              // index, -1 = none
+// A Gamepad player whose controller is missing (they read the keyboard meanwhile).
+bool player_waiting_for_controller(int player);
+// Press to assign: the next key or controller button press becomes `player`'s
+// device (Escape cancels). -1 cancels.
+void begin_device_claim(int player);
+int device_claim_player();
+// Press to bind: the next key (or, with `controller`, a button or stick/trigger
+// direction on the player's controller) becomes `button` (KEYINPUT bit) for
+// `player`. A player without a controller of their own edits the shared
+// input.ini [mapping] fallback, from any controller. A binding the button already
+// had elsewhere is swapped. Escape or 10 seconds cancels; the menu's status
+// line says what happened.
+void begin_binding_capture(int player, int button, bool controller);
+bool binding_capture_active();
+// One device change per call: `player`'s controller came back (connected) or
+// went missing.
+bool take_device_notice(int* player, bool* connected);
+
 }  // namespace gbarecomp
diff --git a/tests/player_controls/test_main.cpp b/tests/player_controls/test_main.cpp
new file mode 100644
index 0000000..6601cbc
--- /dev/null
+++ b/tests/player_controls/test_main.cpp
@@ -0,0 +1,236 @@
+// player_controls_tests — defaults, ini round trips (other lines kept), device
+// assignment, claiming, swapping, conflict swaps and KEYINPUT resolution.
+
+#include "player_controls.h"
+
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+using namespace gbarecomp::controls;
+
+namespace {
+
+int g_failures = 0;
+
+void check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++g_failures;
+    }
+}
+
+// A small stand-in for SDL's name tables, with SDL's numbering where it matters.
+struct Name { const char* name; int code; };
+const Name kKeys[] = {
+    {"A", 4}, {"C", 6}, {"D", 7}, {"G", 10}, {"I", 12}, {"J", 13}, {"K", 14}, {"S", 22}, {"U", 24},
+    {"V", 25}, {"W", 26}, {"X", 27}, {"Z", 29}, {"Return", 40}, {"Space", 44}, {"Right", 79},
+    {"Left", 80}, {"Down", 81}, {"Up", 82}, {"Right Shift", 229}, {"Q", 20}};
+const Name kPadButtonNames[] = {
+    {"a", 0}, {"b", 1}, {"x", 2}, {"y", 3}, {"back", 4}, {"start", 6}, {"leftshoulder", 9},
+    {"rightshoulder", 10}, {"dpup", 11}, {"dpdown", 12}, {"dpleft", 13}, {"dpright", 14}};
+const Name kAxisNames[] = {{"leftx", 0}, {"lefty", 1}, {"rightx", 2}, {"righty", 3},
+                           {"lefttrigger", 4}, {"righttrigger", 5}};
+
+template <std::size_t N>
+int lookup(const Name (&table)[N], const char* name) {
+    for (const Name& n : table)
+        if (!strcasecmp(n.name, name)) return n.code;
+    return -1;
+}
+template <std::size_t N>
+const char* reverse(const Name (&table)[N], int code) {
+    for (const Name& n : table)
+        if (n.code == code) return n.name;
+    return nullptr;
+}
+
+const Names kNames = {
+    [](const char* n) { return lookup(kKeys, n); },
+    [](int c) { return reverse(kKeys, c); },
+    [](const char* n) { return lookup(kPadButtonNames, n); },
+    [](int c) { return reverse(kPadButtonNames, c); },
+    [](const char* n) { return lookup(kAxisNames, n); },
+    [](int c) { return reverse(kAxisNames, c); },
+};
+
+std::string read(const std::filesystem::path& path) {
+    std::ifstream f(path);
+    std::stringstream s;
+    s << f.rdbuf();
+    return s.str();
+}
+
+void write(const std::filesystem::path& path, const std::string& text) {
+    std::ofstream f(path, std::ios::trunc | std::ios::binary);
+    f << text;
+}
+
+void test_defaults() {
+    const Settings s = defaults(kNames);
+    check(s.player[0].source == Source::Auto && s.player[1].source == Source::Auto, "both players default to Auto");
+    check(s.player[0].keys[0] == 27 && s.player[0].keys[1] == 29, "player 1 A/B are X/Z");
+    check(s.player[1].keys[0] == 13 && s.player[1].keys[6] == 26, "player 2 A is J, Up is W");
+    check(s.global.bind[0].kind == PadBind::Button && s.global.bind[0].code == 0, "pad A on button a");
+    check(s.global.bind[2].code == 4 && s.global.bind[9].code == 9, "pad Select on back, L on leftshoulder");
+}
+
+void test_round_trip(const std::filesystem::path& dir) {
+    // Existing files with lines that are not ours: they must survive a save.
+    write(dir / "config.ini", "[Launcher]\nassist_tools = 1\n\n[KeyMap]\nPause = P\n");
+    write(dir / "keybinds.ini", "# comment kept\n[player1]\na = X\nx = S\n\n[player2]\na = X\nb = Z\n");
+    write(dir / "input.ini",
+          "[gamepads]\n030000005e040000e002000000007200 = Xbox Controller\n\n[mapping]\na = b\n\n"
+          "[mapping.030000005e040000e002000000007200]\ndeadzone = 30\nl = lefttrigger+\n");
+    Settings s = load(dir.string(), kNames);
+    check(s.player[1].keys[0] == 27 && s.player[1].keys[1] == 29, "player 2 keys read from keybinds.ini");
+    check(s.player[1].keys[6] == 26, "player 2 keys missing from the file keep their defaults");
+    check(s.global.bind[0].code == 1, "[mapping] overrides the default");
+    const std::string xbox = "030000005e040000e002000000007200";
+    const PadProfile p = profile_for(s, xbox);
+    check(p.deadzone_pct == 30, "per-controller dead zone");
+    check(p.bind[9].kind == PadBind::AxisPositive && p.bind[9].code == 4, "per-controller trigger bind");
+    check(p.bind[0].code == 1, "per-controller profile falls back to [mapping]");
+    check(s.pad_names[xbox] == "Xbox Controller", "[gamepads] names read");
+
+    s.player[1].source = Source::Gamepad;
+    s.player[1].guid = xbox;
+    s.version = 1;
+    set_key(s.player[0], 0, 4);   // player 1 A = "A"
+    check(save(dir.string(), s, kNames), "save succeeds");
+    const std::string config = read(dir / "config.ini");
+    check(config.find("assist_tools = 1") != std::string::npos, "config.ini [Launcher] kept");
+    check(config.find("Pause = P") != std::string::npos, "config.ini [KeyMap] kept");
+    check(config.find("SourceP2 = 2") != std::string::npos, "SourceP2 written");
+    check(config.find("GuidP2 = " + xbox) != std::string::npos, "GuidP2 written");
+    const std::string keys = read(dir / "keybinds.ini");
+    check(keys.find("# comment kept") != std::string::npos, "keybinds.ini comment kept");
+    check(keys.find("x = S") != std::string::npos, "keybinds.ini keys we do not own kept");
+    check(config.find("SourceP1") == std::string::npos, "Auto is written as no SourceP1");
+    const Settings again = load(dir.string(), kNames);
+    check(again.player[1].source == Source::Gamepad && again.player[1].guid == xbox, "player 2 device round trip");
+    check(again.player[0].keys[0] == 4, "player 1 key round trip");
+    check(again.version == 1, "ControlsVersion round trip");
+    check(profile_for(again, xbox).deadzone_pct == 30, "dead zone round trip");
+    check(profile_for(again, xbox).bind[9].kind == PadBind::AxisPositive, "trigger bind round trip");
+
+    // Back to Auto: the stale SourceP2 line goes away.
+    Settings back = again;
+    back.player[1].source = Source::Auto;
+    back.player[1].guid.clear();
+    check(save(dir.string(), back, kNames), "second save succeeds");
+    check(read(dir / "config.ini").find("SourceP2") == std::string::npos, "returning to Auto removes SourceP2");
+    check(load(dir.string(), kNames).player[1].source == Source::Auto, "Auto round trip");
+}
+
+void test_assign() {
+    Settings s = defaults(kNames);
+    const std::vector<PadInfo> pads = {{10, "aaa"}, {11, "bbb"}};
+    Assignment a = assign(s, pads);
+    check(a.pad[0] == 0 && a.pad[1] == 1, "Auto: first controller to player 1, next to player 2");
+    check(a.keyboard[0] && a.keyboard[1], "Auto players also read their keys");
+
+    s.player[1].source = Source::Gamepad;
+    s.player[1].guid = "aaa";
+    a = assign(s, pads);
+    check(a.pad[1] == 0 && a.pad[0] == 1, "a named controller is claimed before Auto players pick");
+    check(!a.keyboard[1], "a Gamepad player with a controller ignores the keyboard");
+
+    a = assign(s, {{11, "bbb"}});
+    check(a.pad[1] == -1 && a.waiting[1] && a.keyboard[1], "missing controller: waiting, keyboard fallback");
+    check(a.pad[0] == 0, "player 1 still gets the free controller");
+
+    s.player[0].source = Source::Keyboard;
+    a = assign(s, pads);
+    check(a.pad[0] == -1 && a.keyboard[0], "Keyboard player gets no controller");
+
+    s.player[0].source = Source::None;
+    a = assign(s, pads);
+    check(a.pad[0] == -1 && !a.keyboard[0], "None reads nothing");
+}
+
+void test_claim_and_swap() {
+    Settings s = defaults(kNames);
+    claim_pad(s, 0, "AAA");
+    check(s.player[0].source == Source::Gamepad && s.player[0].guid == "aaa", "claim sets Gamepad + lowercase GUID");
+    claim_pad(s, 1, "aaa");
+    check(s.player[1].guid == "aaa", "player 2 takes the controller");
+    check(s.player[0].source == Source::Auto && s.player[0].guid.empty(), "player 1 gets player 2's old device");
+
+    claim_keyboard(s, 0);
+    check(s.player[0].source == Source::Keyboard, "claim keyboard");
+    const int p1a = s.player[0].keys[0];
+    swap_players(s);
+    check(s.player[1].source == Source::Keyboard && s.player[1].keys[0] == p1a, "swap moves device and keys");
+    check(s.player[0].guid == "aaa", "swap moves the controller");
+}
+
+void test_conflicts() {
+    Settings s = defaults(kNames);
+    // Player 1: bind A to Z, which B uses. B takes A's old key (X).
+    const int swapped = set_key(s.player[0], 0, 29);
+    check(swapped == 1, "conflicting key reported");
+    check(s.player[0].keys[0] == 29 && s.player[0].keys[1] == 27, "conflicting keys swap");
+
+    PadBind b{PadBind::Button, 1};
+    const int pad_swapped = set_pad_bind(s, "aaa", 0, b);
+    const PadProfile p = profile_for(s, "aaa");
+    check(pad_swapped == 1, "conflicting pad bind reported");
+    check(p.bind[0].code == 1 && p.bind[1].code == 0, "pad binds swap within one controller");
+    check(profile_for(s, "bbb").bind[0].code == 0, "other controllers keep their layout");
+    reset_pad(s, "aaa", kNames);
+    check(profile_for(s, "aaa").bind[0].code == 0, "reset restores the fallback");
+    reset_keys(s, 0, kNames);
+    check(s.player[0].keys[0] == 27, "reset restores default keys");
+}
+
+void test_resolve() {
+    Settings s = defaults(kNames);
+    std::uint8_t keyboard[512] = {};
+    keyboard[27] = 1;   // X
+    keyboard[26] = 1;   // W
+    check(key_buttons(s.player[0].keys, keyboard, 512) == 0x1, "player 1 X = A");
+    check(key_buttons(s.player[1].keys, keyboard, 512) == (1u << 6), "player 2 W = Up");
+
+    PadState pad;
+    pad.button[0] = true;    // a
+    pad.button[13] = true;   // dpleft
+    PadProfile p = profile_for(s, "");
+    check(pad_buttons(p, pad) == ((1u << 0) | (1u << 5)), "pad buttons");
+    pad = PadState{};
+    pad.axis[kLeftX] = 20000;
+    check(pad_buttons(p, pad) == (1u << 4), "stick past the dead zone moves right");
+    pad.axis[kLeftX] = 10000;
+    check(pad_buttons(p, pad) == 0, "stick inside the dead zone does nothing");
+    p.deadzone_pct = 25;
+    check(pad_buttons(p, pad) == (1u << 4), "smaller dead zone");
+    p.bind[9] = PadBind{PadBind::AxisPositive, 4};
+    pad = PadState{};
+    pad.axis[4] = 30000;
+    check(pad_buttons(p, pad) == (1u << 9), "trigger bound to L");
+}
