+int main() {
+    const std::filesystem::path dir = std::filesystem::temp_directory_path() / "gbarecomp_player_controls_test";
+    std::filesystem::remove_all(dir);
+    std::filesystem::create_directories(dir);
+    test_defaults();
+    test_round_trip(dir);
+    test_assign();
+    test_claim_and_swap();
+    test_conflicts();
+    test_resolve();
+    std::filesystem::remove_all(dir);
+    if (g_failures) {
+        std::fprintf(stderr, "%d failure(s)\n", g_failures);
+        return 1;
+    }
+    std::printf("player_controls_tests: ok\n");
+    return 0;
+}
