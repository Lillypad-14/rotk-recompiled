+// A player's pressed GBA buttons (active-high): their keys while they read the
+// keyboard, and their controller through its input.ini profile.
+std::uint16_t player_held(Backend* b, int player) {
+    std::uint16_t held = 0;
+    if (b->assigned.keyboard[player]) {
+        int count = 0;
+        const Uint8* keyboard = SDL_GetKeyboardState(&count);
+        held |= controls::key_buttons(b->controls.player[player].keys, keyboard, count);
+    }
+    const int index = b->assigned.pad[player];
+    if (index >= 0 && index < static_cast<int>(b->pads.size()) &&
+        SDL_GameControllerGetAttached(b->pads[index])) {
+        SDL_GameController* pad = b->pads[index];
+        controls::PadState state;
+        for (int i = 0; i < SDL_CONTROLLER_BUTTON_MAX && i < controls::kPadButtons; ++i)
+            state.button[i] = SDL_GameControllerGetButton(pad, static_cast<SDL_GameControllerButton>(i)) != 0;
+        for (int i = 0; i < SDL_CONTROLLER_AXIS_MAX && i < controls::kPadAxes; ++i)
+            state.axis[i] = SDL_GameControllerGetAxis(pad, static_cast<SDL_GameControllerAxis>(i));
+        held |= controls::pad_buttons(controls::profile_for(b->controls, b->pad_guids[index]), state);
+    }
+    return held;
+}
