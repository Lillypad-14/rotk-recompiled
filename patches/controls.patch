+// SDL's names for player_controls.h (keys use scancode_from_name's aliases).
+const controls::Names& sdl_control_names() {
+    static const controls::Names names = {
+        [](const char* n) { return static_cast<int>(scancode_from_name(n)); },
+        [](int sc) { return SDL_GetScancodeName(static_cast<SDL_Scancode>(sc)); },
+        [](const char* n) { return static_cast<int>(SDL_GameControllerGetButtonFromString(n)); },
+        [](int button) { return SDL_GameControllerGetStringForButton(static_cast<SDL_GameControllerButton>(button)); },
+        [](const char* n) { return static_cast<int>(SDL_GameControllerGetAxisFromString(n)); },
+        [](int axis) { return SDL_GameControllerGetStringForAxis(static_cast<SDL_GameControllerAxis>(axis)); },
+    };
+    return names;
+}
+
+// The open window's controls, for the free functions in runtime.h.
+Backend* g_controls_backend = nullptr;
+
+// Player 2's controls from the older per-option settings
+// (set_player_two_controls), waiting for the files to be read.
+bool g_legacy_two = false;
+std::string g_legacy_two_keys[controls::kButtons];
+std::string g_legacy_two_pads[controls::kButtons];
+
+void save_player_controls(Backend* b) {
+    if (b->controls_dir.empty()) return;
+    if (!controls::save(b->controls_dir, b->controls, sdl_control_names()))
+        std::fprintf(stderr, "host_window: could not save the controls in %s\n", b->controls_dir.c_str());
+    reassign_controllers(b);
+}
+
+// ControlsVersion 2: player 2's older settings applied (or the player already
+// changed controls since). Their keys replace keybinds.ini [player2]; a
+// controller button they changed becomes the [mapping] fallback, the only
+// per-player controller layout there was.
+void apply_legacy_player_two(Backend* b) {
+    if (!g_legacy_two || b->controls_dir.empty() || b->controls.version >= 2) return;
+    const controls::Names& names = sdl_control_names();
+    const controls::Settings built_in = controls::defaults(names);
+    for (int i = 0; i < controls::kButtons; ++i) {
+        const int sc = names.scancode(g_legacy_two_keys[i].c_str());
+        if (sc > 0) b->controls.player[1].keys[i] = sc;
+        const controls::PadBind bind = controls::parse_bind(g_legacy_two_pads[i], names);
+        if (bind.kind != controls::PadBind::Unbound &&
+            (bind.kind != built_in.global.bind[i].kind || bind.code != built_in.global.bind[i].code)) {
+            b->controls.global.bind[i] = bind;
+        }
+    }
+    b->controls.version = 2;
+    save_player_controls(b);
+}
+
+void set_controls_status(Backend* b, const char* text) {
+#if defined(GBARECOMP_RUNTIME_UI)
