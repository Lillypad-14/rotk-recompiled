[[feature]]
id = "stereo"
name = "Stereo sound"
description = "Plays the game in stereo, as on the GBA. Off mixes everything to mono."
group = "Audio"
default_enabled = true

[[feature]]
id = "hd-audio"
name = "HD audio"
description = "Mixes the music and sound effects on the PC at 65 kHz instead of the GBA's 16 kHz 8-bit mix: clearer highs, no hiss."
group = "Audio"
default_enabled = true

[[option]]
feature = "hd-audio"
id = "interpolation"
label = "Sample smoothing"
type = "choice"
default = "cubic"

[[option.choice]]
value = "cubic"
label = "Smooth (cubic)"

[[option.choice]]
value = "linear"
label = "Linear"

[[option.choice]]
value = "guest"
label = "Original (as on GBA)"

[[option]]
feature = "hd-audio"
id = "sample-packs"
label = "Instrument sample packs"
description = "Plays instruments from the sample packs in the rotk.pc package (samples/), if any are installed, in place of the GBA's. Not used with Original smoothing."
type = "boolean"
default = true

