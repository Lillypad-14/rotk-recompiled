# Built-in package for the PC enhancements. CMake fills in the target ROM and copies it to
# <exe>/mods/packages/rotk.pc/<version>/manifest.toml. The features are read by src/main.cpp.
format_version = 1
id = "rotk.pc"
version = "1.0.0"
name = "ROTK PC Enhancements"
author = "ROTK Recompiled"
description = "Lifts GBA limits. With every feature off the game runs exactly like the original."
license = "MIT"
resolver = "declarative"
save_compatibility = "shared"

[[target]]
game_id = "@ROTK_MOD_GAME_ID@"
rom_sha1 = "@ROTK_ROM_SHA1@"

[[feature]]
id = "large-memory"
name = "Large game memory"
description = "Moves the game's heap from 246 KB of GBA work RAM into PC memory, so busy scenes and mods cannot run out."
group = "Engine"
default_enabled = true

[[option]]
feature = "large-memory"
id = "heap-mb"
label = "Heap size (MB)"
type = "integer"
default = 32
min = 4
max = 48
step = 4

[[feature]]
id = "actor-limits"
name = "Bigger actor limits"
description = "Room for more enemies, projectiles and effects at once (GBA: 256 actors, 40 overlay). Also fixes draw order past 256 actors."
group = "Engine"
default_enabled = true

[[option]]
feature = "actor-limits"
id = "main-actors"
label = "Actors"
type = "integer"
default = 1024
min = 256
max = 2048
step = 64

[[option]]
feature = "actor-limits"
id = "overlay-actors"
label = "Overlay actors"
type = "integer"
default = 160
min = 40
max = 320
step = 8

[[feature]]
id = "sprite-limits"
name = "More sprites on screen"
description = "Draws sprite pieces past the GBA's 128, so crowds stop disappearing."
group = "Engine"
default_enabled = true

[[option]]
feature = "sprite-limits"
id = "max-sprites"
label = "Sprite pieces"
type = "integer"
default = 1024
min = 256
max = 2048
step = 128

[[feature]]
id = "cpu-boost"
name = "CPU boost"
description = "Gives the game more CPU time per frame so busy fights stop slowing down. Music and game speed are unchanged."
group = "Performance"
default_enabled = true

[[option]]
feature = "cpu-boost"
id = "speed"
label = "Speed"
type = "choice"
default = "4"

[[option.choice]]
value = "2"
label = "x2"

[[option.choice]]
value = "4"
label = "x4"

[[option.choice]]
value = "8"
label = "x8"

[[option.choice]]
value = "16"
label = "x16"

[[feature]]
id = "widescreen"
name = "Widescreen"
description = "Shows more of the level to the left and right during gameplay. Menus keep their original width with black bars. Work in progress: some enemies near the edges may appear late."
group = "Display"
default_enabled = false

[[option]]
feature = "widescreen"
id = "width"
label = "Aspect ratio"
type = "choice"
default = "284"

[[option.choice]]
value = "256"
label = "16:10"

[[option.choice]]
value = "284"
label = "16:9"

[[option.choice]]
value = "320"
label = "2:1"

[[option.choice]]
value = "374"
label = "21:9"

[[option]]
feature = "widescreen"
id = "hud-edges"
label = "HUD at screen edges"
description = "Moves the health and spirit bars to the edges of the wide screen. Off keeps the HUD centred as on the GBA."
type = "boolean"
default = false

[[feature]]
id = "smooth-motion"
name = "Smooth motion (60 fps)"
description = "The game updates 30 times a second. This draws a halfway frame in between, so scrolling and movement look like 60 fps. Gameplay is unchanged. Works best with CPU boost."
group = "Display"
default_enabled = false

[[option]]
feature = "smooth-motion"
id = "particles"
label = "Smooth particles"
description = "Also draws spell sparkles and other particles at 60 fps. Off keeps them at the game's 30 fps."
type = "boolean"
default = true

[[option]]
feature = "smooth-motion"
id = "parallax"
label = "Smooth parallax background"
description = "Also scrolls the far background layer at 60 fps. Off keeps it at the game's 30 fps."
type = "boolean"
default = true

[[feature]]
id = "transparency"
name = "Real transparency"
description = "Draws see-through effects such as water and ice reflections as real transparency instead of the GBA's every-other-frame flicker."
group = "Display"
default_enabled = false

[[option]]
feature = "transparency"
id = "strength"
label = "Reflection strength"
description = "How visible see-through effects are. The GBA flicker looked like about 50%."
type = "choice"
default = "35"

[[option.choice]]
value = "25"
label = "Faint (25%)"

[[option.choice]]
value = "35"
label = "Medium (35%)"

[[option.choice]]
value = "50"
label = "Strong (50%)"

[[feature]]
id = "hd-icons"
name = "HD skill icons"
description = "Draws the custom skill icons from the original art at full resolution and in full color instead of the GBA's 32x24, 16-color version."
group = "Display"
default_enabled = false

[[option]]
feature = "hd-icons"
id = "resolution"
label = "Render resolution"
description = "The internal resolution the HD art is drawn at, as a multiple of the GBA screen. Higher is sharper and costs more."
type = "choice"
default = "4"

[[option.choice]]
value = "3"
label = "3x"

[[option.choice]]
value = "4"
label = "4x"

[[option.choice]]
value = "6"
label = "6x"

[[feature]]
id = "local-coop"
name = "Split-screen co-op (experimental)"
description = "Choosing Multiplayer starts two-player co-op on this PC. Player 2 uses a second controller or WASD, J/K and Space. Both consoles use private engine buffers, even with solo engine limits off. Widescreen, smooth motion and transparency work per console; CPU boost and HD audio stay off during co-op. Your save is backed up first."
group = "Gameplay"
default_enabled = true

[[option]]
feature = "local-coop"
id = "player2-save"
label = "Player 2 save"
description = "Player 2's own save starts as a copy of yours and keeps player 2's progress between sessions (delete rotk.player2.sram to start it over). A copy of yours each session keeps nothing."
type = "choice"
default = "own"

[[option.choice]]
value = "own"
label = "Player 2's own save"

[[option.choice]]
value = "copy"
label = "A copy of yours each session"

[[feature]]
id = "stereo"
name = "Stereo sound"
description = "Plays the game in stereo, as on the GBA. Off mixes everything to mono."
group = "Audio"
default_enabled = true

[[feature]]
id = "hd-audio"
name = "HD audio"
description = "Mixes the music and sound effects on the PC at 65 kHz instead of the GBA's 16 kHz 8-bit mix: clearer highs, no hiss."
group = "Audio"
default_enabled = false

[[option]]
feature = "hd-audio"
id = "interpolation"
label = "Sample smoothing"
type = "choice"
default = "cubic"

[[option.choice]]
value = "cubic"
label = "Smooth (cubic)"

[[option.choice]]
value = "linear"
label = "Linear"

[[option.choice]]
value = "guest"
label = "Original (as on GBA)"

[[plugin]]
feature = "large-memory"
id = "rotk.pc.large-memory"

[[plugin]]
feature = "actor-limits"
id = "rotk.pc.actor-limits"

[[plugin]]
feature = "sprite-limits"
id = "rotk.pc.sprite-limits"

[[plugin]]
feature = "cpu-boost"
id = "rotk.pc.cpu-boost"

[[plugin]]
feature = "widescreen"
id = "rotk.pc.widescreen"

[[plugin]]
feature = "smooth-motion"
id = "rotk.pc.smooth-motion"

[[plugin]]
feature = "transparency"
id = "rotk.pc.transparency"

[[plugin]]
feature = "hd-icons"
id = "rotk.pc.hd-icons"

[[plugin]]
feature = "local-coop"
id = "rotk.pc.local-coop"

[[plugin]]
feature = "stereo"
id = "rotk.pc.stereo"

[[plugin]]
feature = "hd-audio"
id = "rotk.pc.hd-audio"
