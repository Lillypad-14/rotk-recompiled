# Built-in package for the PC enhancements. CMake fills in the target ROM and copies it to
# <exe>/mods/packages/rotk.pc/<version>/manifest.toml. The features are read by src/main.cpp.
format_version = 1
id = "rotk.pc"
version = "1.0.0"
name = "ROTK PC Enhancements"
author = "ROTK Recompiled"
description = "Lifts GBA limits. With every feature off the game runs exactly like the original."
license = "MIT"
resolver = "declarative"
save_compatibility = "shared"

[[target]]
game_id = "@ROTK_MOD_GAME_ID@"
rom_sha1 = "@ROTK_ROM_SHA1@"

[[feature]]
id = "large-memory"
name = "Large game memory"
description = "Moves the game's heap from 246 KB of GBA work RAM into PC memory, so busy scenes and mods cannot run out."
group = "Engine"
default_enabled = true

[[option]]
feature = "large-memory"
id = "heap-mb"
label = "Heap size (MB)"
type = "integer"
default = 32
min = 4
max = 48
step = 4

[[feature]]
id = "actor-limits"
name = "Bigger actor limits"
description = "Room for more enemies, projectiles and effects at once (GBA: 256 actors, 40 overlay). Also fixes draw order past 256 actors."
group = "Engine"
default_enabled = true

[[option]]
feature = "actor-limits"
id = "main-actors"
label = "Actors"
type = "integer"
default = 1024
min = 256
max = 2048
step = 64

[[option]]
feature = "actor-limits"
id = "overlay-actors"
label = "Overlay actors"
type = "integer"
default = 160
min = 40
max = 320
step = 8

[[feature]]
id = "sprite-limits"
name = "More sprites on screen"
description = "Draws sprite pieces past the GBA's 128, so crowds stop disappearing."
group = "Engine"
default_enabled = true

[[option]]
feature = "sprite-limits"
id = "max-sprites"
label = "Sprite pieces"
type = "integer"
default = 1024
min = 256
max = 2048
step = 128

[[feature]]
id = "cpu-boost"
name = "CPU boost"
description = "Gives the game more CPU time per frame so busy fights stop slowing down. Music and game speed are unchanged."
group = "Performance"
default_enabled = true

[[option]]
feature = "cpu-boost"
id = "speed"
label = "Speed"
type = "choice"
default = "4"

[[option.choice]]
value = "2"
label = "x2"

[[option.choice]]
value = "4"
label = "x4"

[[option.choice]]
value = "8"
label = "x8"

[[option.choice]]
value = "16"
label = "x16"

[[feature]]
id = "widescreen"
name = "Widescreen"
description = "Shows more of the level to the left and right during gameplay. Menus keep their original width with black bars. Work in progress: some enemies near the edges may appear late."
group = "Display"
default_enabled = false

[[option]]
feature = "widescreen"
id = "width"
label = "Aspect ratio"
type = "choice"
default = "284"

[[option.choice]]
value = "256"
label = "16:10"

[[option.choice]]
value = "284"
label = "16:9"

[[option.choice]]
value = "320"
label = "2:1"

[[option.choice]]
value = "374"
label = "21:9"

[[option]]
feature = "widescreen"
id = "hud-edges"
label = "HUD at screen edges"
description = "Moves the health and spirit bars to the edges of the wide screen. Off keeps the HUD centred as on the GBA."
type = "boolean"
default = false

[[feature]]
id = "hd-audio"
name = "HD audio"
description = "Mixes the music and sound effects on the PC at 65 kHz instead of the GBA's 16 kHz 8-bit mix: clearer highs, no hiss. Work in progress: mono for now."
group = "Audio"
default_enabled = false

[[option]]
feature = "hd-audio"
id = "interpolation"
label = "Sample smoothing"
type = "choice"
default = "cubic"

[[option.choice]]
value = "cubic"
label = "Smooth (cubic)"

[[option.choice]]
value = "linear"
label = "Linear"

[[option.choice]]
value = "guest"
label = "Original (as on GBA)"

[[plugin]]
feature = "large-memory"
id = "rotk.pc.large-memory"

[[plugin]]
feature = "actor-limits"
id = "rotk.pc.actor-limits"

[[plugin]]
feature = "sprite-limits"
id = "rotk.pc.sprite-limits"

[[plugin]]
feature = "cpu-boost"
id = "rotk.pc.cpu-boost"

[[plugin]]
feature = "widescreen"
id = "rotk.pc.widescreen"

[[plugin]]
feature = "hd-audio"
id = "rotk.pc.hd-audio"
