# Built-in package for the PC enhancements. CMake fills in the target ROM and copies it to
# <exe>/mods/packages/rotk.pc/<version>/manifest.toml. The features are read by src/main.cpp.
format_version = 1
id = "rotk.pc"
version = "1.0.0"
name = "ROTK PC Enhancements"
author = "ROTK Recompiled"
description = "Lifts GBA limits. With every feature off the game runs exactly like the original."
license = "MIT"
resolver = "declarative"
save_compatibility = "shared"

[[target]]
game_id = "@ROTK_MOD_GAME_ID@"
rom_sha1 = "@ROTK_ROM_SHA1@"
@ROTK_EDITION_TARGET@
[[feature]]
id = "large-memory"
name = "Large game memory"
description = "Moves the game's heap from 246 KB of GBA work RAM into PC memory, so busy scenes and mods cannot run out."
group = "Engine"
default_enabled = true

[[option]]
feature = "large-memory"
id = "heap-mb"
label = "Heap size (MB)"
type = "integer"
default = 32
min = 4
max = 48
step = 4

[[feature]]
id = "actor-limits"
name = "Bigger actor limits"
description = "Room for more enemies, projectiles and effects at once (GBA: 256 actors, 40 overlay). Also fixes draw order past 256 actors."
group = "Engine"
default_enabled = true

[[option]]
feature = "actor-limits"
id = "main-actors"
label = "Actors"
type = "integer"
default = 1024
min = 256
max = 2048
step = 64

[[option]]
feature = "actor-limits"
id = "overlay-actors"
label = "Overlay actors"
type = "integer"
default = 160
min = 40
max = 320
step = 8

[[feature]]
id = "sprite-limits"
name = "More sprites on screen"
description = "Draws sprite pieces past the GBA's 128, so crowds stop disappearing."
group = "Engine"
default_enabled = true

[[option]]
feature = "sprite-limits"
id = "max-sprites"
label = "Sprite pieces"
type = "integer"
default = 1024
min = 256
max = 2048
step = 128

[[feature]]
id = "cpu-boost"
name = "CPU boost"
description = "Gives the game more CPU time per frame so busy fights stop slowing down. Music and game speed are unchanged."
group = "Performance"
default_enabled = true

[[option]]
feature = "cpu-boost"
id = "speed"
label = "Speed"
type = "choice"
default = "4"

[[option.choice]]
value = "2"
label = "x2"

[[option.choice]]
value = "4"
label = "x4"

[[option.choice]]
value = "8"
label = "x8"

[[option.choice]]
value = "16"
label = "x16"

[[feature]]
id = "widescreen"
name = "Widescreen"
description = "Shows more of the level to the left and right during gameplay. Menus keep their original width with black bars. Work in progress: some enemies near the edges may appear late."
group = "Display"
default_enabled = false

[[option]]
feature = "widescreen"
id = "width"
label = "Aspect ratio"
type = "choice"
default = "284"

[[option.choice]]
value = "256"
label = "16:10"

[[option.choice]]
value = "284"
label = "16:9"

[[option.choice]]
value = "320"
label = "2:1"

[[option.choice]]
value = "374"
label = "21:9"

[[option]]
feature = "widescreen"
id = "hud-edges"
label = "HUD at screen edges"
description = "Moves the health and spirit bars to the edges of the wide screen. Off keeps the HUD centred as on the GBA."
type = "boolean"
default = false

[[feature]]
id = "smooth-motion"
name = "Smooth motion (60 fps)"
description = "The game updates 30 times a second. This draws a halfway frame in between, so scrolling and movement look like 60 fps. Gameplay is unchanged. Works best with CPU boost."
group = "Display"
default_enabled = true

[[option]]
feature = "smooth-motion"
id = "particles"
label = "Smooth particles"
description = "Also draws spell sparkles and other particles at 60 fps. Off keeps them at the game's 30 fps."
type = "boolean"
default = true

[[option]]
feature = "smooth-motion"
id = "parallax"
label = "Smooth parallax background"
description = "Also scrolls the far background layer at 60 fps. Off keeps it at the game's 30 fps."
type = "boolean"
default = true

[[feature]]
id = "combat-info"
name = "Health bars and damage numbers"
description = "Shows a health bar over hurt enemies and the damage of each hit, drawn in the game's pixel style. Display only: gameplay is unchanged."
group = "Display"
default_enabled = false

[[option]]
feature = "combat-info"
id = "health-bars"
label = "Enemy health bars"
type = "boolean"
default = true

[[option]]
feature = "combat-info"
id = "always"
label = "Bars on unhurt enemies"
description = "Also shows the bar on enemies at full health. Off shows it once an enemy is hurt."
type = "boolean"
default = false

[[option]]
feature = "combat-info"
id = "damage-numbers"
label = "Damage numbers"
description = "Shows the damage of each hit rising from the enemy."
type = "boolean"
default = true

[[feature]]
id = "minimap"
name = "Minimap"
description = "A small map of the level in the top right corner, with your view, both players and the enemies. Display only."
group = "Display"
default_enabled = false

[[option]]
feature = "minimap"
id = "enemies"
label = "Show enemies"
type = "boolean"
default = true

[[feature]]
id = "color-vision"
name = "Color vision correction"
description = "Recolors the screen so colors that are hard to tell apart with color blindness look different. Display only."
group = "Accessibility"
default_enabled = false

[[option]]
feature = "color-vision"
id = "type"
label = "Type"
type = "choice"
default = "deutan"

[[option.choice]]
value = "deutan"
label = "Deuteranopia (green)"

[[option.choice]]
value = "protan"
label = "Protanopia (red)"

[[option.choice]]
value = "tritan"
label = "Tritanopia (blue)"

[[feature]]
id = "rumble"
name = "Controller rumble"
description = "Rumbles your controller when your hero is hit (harder for bigger hits) and on level-ups. In co-op each player's own controller rumbles."
group = "Gameplay"
default_enabled = false

[[option]]
feature = "rumble"
id = "strength"
label = "Strength"
type = "choice"
default = "2"

[[option.choice]]
value = "1"
label = "Light"

[[option.choice]]
value = "2"
label = "Normal"

[[option.choice]]
value = "3"
label = "Strong"

[[option]]
feature = "rumble"
id = "hits"
label = "When hit"
type = "boolean"
default = true

[[option]]
feature = "rumble"
id = "level-up"
label = "On level-up"
type = "boolean"
default = true

[[feature]]
id = "transparency"
name = "Real transparency"
description = "Draws see-through effects such as water and ice reflections as real transparency instead of the GBA's every-other-frame flicker."
group = "Display"
default_enabled = true

[[option]]
feature = "transparency"
id = "strength"
label = "Reflection strength"
description = "How visible see-through effects are. The GBA flicker looked like about 50%."
type = "choice"
default = "35"

[[option.choice]]
value = "25"
label = "Faint (25%)"

[[option.choice]]
value = "35"
label = "Medium (35%)"

[[option.choice]]
value = "50"
label = "Strong (50%)"

[[feature]]
id = "hd-icons"
name = "HD skill icons"
description = "Draws the custom skill icons from the original art at full resolution and in full color instead of the GBA's 32x24, 16-color version."
group = "Display"
default_enabled = true

[[option]]
feature = "hd-icons"
id = "resolution"
label = "Render resolution"
description = "The internal resolution the HD art is drawn at, as a multiple of the GBA screen. Higher is sharper and costs more."
type = "choice"
default = "6"

[[option.choice]]
value = "3"
label = "3x"

[[option.choice]]
value = "4"
label = "4x"

[[option.choice]]
value = "6"
label = "6x"

[[feature]]
id = "local-coop"
name = "Split-screen co-op (experimental)"
description = "Choosing Multiplayer starts two-player co-op on this PC. Player 2 uses a second controller or WASD, J/K and Space, changeable below or in the in-game menu. Both consoles use private engine buffers, even with solo engine limits off. Widescreen, smooth motion, transparency, HD icons, health bars, CPU boost and HD audio all work in co-op. Your save is backed up first."
group = "Gameplay"
default_enabled = true

[[option]]
feature = "local-coop"
id = "player2-save"
label = "Player 2 save"
description = "Player 2's own save starts as a copy of yours and keeps player 2's progress between sessions (delete rotk.player2.sram to start it over). A copy of yours each session keeps nothing."
type = "choice"
default = "own"

[[option.choice]]
value = "own"
label = "Player 2's own save"

[[option.choice]]
value = "copy"
label = "A copy of yours each session"

# Player 2's old controls, replaced by the Controls page (keybinds.ini, input.ini). Kept so
# gbarecomp::set_player_two_controls can migrate them once; the lists match src/player2_controls.cpp.
[[option]]
feature = "local-coop"
id = "p2-key-a"
label = "Player 2 A (keyboard)"
description = "Replaced by Controls (launcher Controller page, in-game menu). Your old choice was carried over once."
group = "Old player 2 controls"
type = "choice"
default = "J"

